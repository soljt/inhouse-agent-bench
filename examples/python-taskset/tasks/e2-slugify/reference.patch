+"""URL slugs."""
+import re
+
+from .text import normalize_whitespace
+
+
+def slugify(title: str) -> str:
+    """Lower case words of a-z and 0-9, joined by single hyphens."""
+    words = re.sub(r'[^a-z0-9]+', ' ', title.lower())
+    return normalize_whitespace(words).replace(' ', '-')
