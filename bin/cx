#!/usr/bin/env bash
# Codex launcher.  Usage: bin/cx [local|openai] [codex args...]   (dryrun = openai)
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. "$REPO/scripts/env.sh" "$REPO/.env"

target="local"
case "${1:-}" in local|openai|dryrun) target="$1"; shift ;; esac

# Isolated Codex home: no personal ChatGPT auth, history or memories leak in.
export CODEX_HOME="$REPO/.codex-home"
mkdir -p "$CODEX_HOME"
cp "$REPO"/codex/*.toml "$CODEX_HOME/"

overrides=(-c "model_providers.local.base_url=\"$LOCAL_BASE_URL\"")
if is_openai_target "$target"; then
  overrides+=(-p openai-api -c "model=\"$OPENAI_MODEL\"")
else
  overrides+=(-p local -c "model=\"$LOCAL_MODEL\"")
fi
exec codex "${overrides[@]}" "$@"
