# Copy to .env (gitignored) and fill in. Both launchers in bin/ read this file.

# --- Target "openai": OpenAI's API (platform API key, not a ChatGPT login) ---
# (the older name DRYRUN_MODEL still works). Reasoning effort is high, set in codex/ and opencode/.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# --- Target "local": your OpenAI-compatible server (vLLM), e.g. through an SSH tunnel to localhost ---
# 
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=
LOCAL_MODEL=qwen3.8-27b

# --- Benchmark: the task set folder (see bench/lib/taskset.py) ---
BENCH_TASKSET=
